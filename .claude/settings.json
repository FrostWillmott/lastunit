{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(npm run *)",
      "Bash(npm ci *)",
      "Bash(npm test)",
      "Bash(docker compose build)",
      "Bash(docker compose up *)",
      "Bash(docker compose down)",
      "Bash(docker compose logs *)",
      "Bash(docker compose ps)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/lint-on-edit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/warn-non-anthropic.sh"
          }
        ]
      }
    ]
  }
}
