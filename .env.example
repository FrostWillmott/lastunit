# Template for .env. Do not copy by hand: `make env` (called by `make install`
# and `make up`) copies it and fills every empty value with a random secret.
# Non-secret values carry their local-dev default. Never put real secrets here.
# One variable per line, comments on their own lines: `make env` detects a
# secret by an empty value after `=`.

# --- Backend app (app/config.py Settings) ---

# Runtime environment: dev (API docs enabled) or prod (docs disabled).
APP_ENV=dev
# Log level for the backend app.
LOG_LEVEL=INFO
# Session lifetime for the login cookie, in days.
SESSION_TTL_DAYS=30

# --- Docker Compose (docker-compose.yml) ---

# Database role; also used by the healthcheck.
POSTGRES_USER=app
# Secret. Generated by `make env`; compose refuses to start without it.
POSTGRES_PASSWORD=
# Database name.
POSTGRES_DB=app

# --- Frontend (frontend/vite.config.ts) ---

# Backend origin the Vite dev proxy forwards /api to.
VITE_API_URL=http://localhost:8000
